# WorldForge environment configuration.
# Copy to `.env` and adjust for your deployment. Never commit `.env`.

# SQLite database file. Prisma resolves relative paths from `prisma/`, so
# `file:./dev.db` creates `prisma/dev.db`.
DATABASE_URL="file:./dev.db"

# Required in production; development uses the request origin when unset.
# Set this to the browser-visible origin (including scheme and any non-default
# port). Use its canonical form with no trailing slash and match the browser
# URL exactly. Behind a reverse proxy, use the public HTTPS origin.
# WORLDFORGE_ORIGIN="https://world.example"

# Docker Compose only: host-side port mapped to the container's port 3033.
WORLDFORGE_HOST_PORT="3033"
# Docker Compose binds the app to loopback by default. Keep this private behind a reverse proxy.
# WORLDFORGE_HOST_BIND="127.0.0.1"
# Public HTTPS deployments require a proxy that overwrites X-WorldForge-Client-IP.
# WORLDFORGE_TRUSTED_PROXY="1"

# Directory for uploaded images. Defaults to `./data/assets` when unset. In
# production this should point at a persistent volume.
WORLDFORGE_ASSET_DIR="./data/assets"
