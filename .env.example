# WorldForge environment configuration.
# Copy to `.env` and adjust for your deployment. Never commit `.env`.

# SQLite database file. Prisma resolves relative paths from `prisma/`, so
# `file:./dev.db` creates `prisma/dev.db`.
DATABASE_URL="file:./dev.db"

# Public origin used for same-origin/CSRF checks on write requests. It must
# match the URL you open in the browser (scheme + host + port), otherwise
# mutations are rejected with 403.
WORLDFORGE_ORIGIN="http://localhost:3033"

# Directory for uploaded images. Defaults to `./data/assets` when unset. In
# production this should point at a persistent volume.
WORLDFORGE_ASSET_DIR="./data/assets"
