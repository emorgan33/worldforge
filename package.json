{
  "name": "worldforge",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "serve:local": "bash scripts/serve-local.sh",
    "lint": "eslint",
    "test": "node scripts/run-tests.mjs all",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:service": "node scripts/run-tests.mjs service",
    "test:http": "node scripts/run-tests.mjs http",
    "test:browser": "playwright test",
    "test:production-auth": "node --import tsx --test --test-concurrency=1 tests/production-auth-smoke.test.ts",
    "auth:setup": "tsx scripts/auth-setup.ts",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "stock-art:validate": "tsx scripts/validate-stock-art.ts",
    "stock-art:advisories": "tsx scripts/apply-stock-advisories.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-mention": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "clsx": "^2.1.1",
    "htmlparser2": "10.0.0",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "postcss": "8.5.23",
    "postcss-selector-parser": "7.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@prisma/client": "6.19.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.14.0"
}
